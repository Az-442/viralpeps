            ['Mitochondrial-derived peptides', 'MOTS-c, Humanin', 'Early-stage', 'Moderate — metabolic support for growth'],
            ['Multi-pathway stacking', 'GHRH + GHS + IGF-1 LR3 + Follistatin', 'Anecdotal / exploratory', 'High — theoretical synergy across pathways'],
            ['Long-acting GHRH analogues', 'Next-gen DAC-modified GHRH', 'In development', 'High — improved dosing convenience and pulse control'],

<style id="wp-custom-css">
.call-back-feature {
    display: none !important;
}
/* Hide WooCommerce Related Products section */
.woocommerce .related.products,
.woocommerce .up-sells.upsells.products,
.woocommerce .cross-sells,
.woocommerce .you-may-also-like,
.woocommerce section.related,
.woocommerce-cart .related.products,
.woocommerce-checkout .related.products {
    display: none !important;
}
/* Style checkbox */
.cart-terms-box {
  text-align: center;
  margin-top: 20px;
  margin-bottom: 20px;
  font-size: 14px;
}
.checkout-addon {
    border: 1px solid #eaeaea;
    padding: 15px;
    margin-bottom: 15px;
    background: #fafafa;
}

.addon-text {
    margin-bottom: 10px;
    color: #333;
}

.checkout-addon-inner {
    display: flex;
    gap: 15px;
    align-items: center;
    cursor: pointer;
}

.checkout-addon img {
    max-width: 70px;
}

.qty-control {
    display: flex;
    gap: 5px;
    margin-top: 6px;
}

.qty-control button {
    padding: 2px 8px;
}

.qty-control input {
    width: 50px;
    text-align: center;
}
/* Add card logos under Bankful payment method */
.payment_method_bankful label::after {
    content: "";
    display: block;
    margin-top: 8px;
    width: 220px;
    height: 30px;
    background-image: url("https://www.testedpeptides.co.uk/wp-content/uploads/2026/03/payments.png");
    background-size: contain;
    background-repeat: no-repeat;
}
function getDeliveryDay() {
    const now = new Date();
    const day = now.getDay(); // 0=Sun
    const hours = now.getHours();
    const minutes = now.getMinutes();

    const afterCutoff = (hours > 15 || (hours === 15 && minutes >= 30));

    let delivery = "";

    if (!afterCutoff) {
        if (day >= 1 && day <= 4) delivery = "Tomorrow";
        else if (day === 5) delivery = "Monday";
    } else {
        if (day >= 1 && day <= 3) delivery = "in 2 days";
        else if (day === 4) delivery = "Monday";
        else if (day === 5) delivery = "Tuesday";
        else delivery = "Tuesday";
    }

    return delivery;
}

document.addEventListener("DOMContentLoaded", function () {
    const el = document.querySelector(".cutoff-timer-message"); // may vary
    if (el) {
        el.innerHTML = "Get it " + getDeliveryDay() + " (order within " + el.innerText.match(/\d.*$/)[0];
    }
});
.cutoff-timer,
.cutoff-timer-wrapper {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
}
.product_meta .sku_wrapper {
    display: none !important;
}
</style>
